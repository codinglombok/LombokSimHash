{
  "name": "codinglombok/lomboksimhash",
  "description": "Locality-sensitive hashing for near-duplicate document detection. SimHash, MinHash, LSH, SHA-256, and shingling.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "CodingLombok",
      "email": "codinglombok@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-gmp": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "CodingLombok\\LombokSimHash\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse src tests --level=max --no-progress",
    "lint": [
      "@php composer validate --strict",
      "@phpstan"
    ]
  },
  "homepage": "https://github.com/codinglombok/LombokSimHash",
  "keywords": [
    "simhash",
    "minhash",
    "lsh",
    "deduplication",
    "hashing",
    "locality-sensitive-hashing",
    "near-duplicate",
    "lombok"
  ]
}
